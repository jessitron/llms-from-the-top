#!/usr/bin/env bash
# Deploys the base and chat model APIs to Modal as a persistent app.
# Unlike ./run (modal serve), this returns immediately and keeps running
# — with GPU billing — until you run ./stop.
#
# `modal deploy` returns before the containers have actually started, so the
# first real request would otherwise pay for the GPU spin-up and model load.
# We send one warm-up request to each right after deploying to eat that cold
# start.
set -euo pipefail
cd "$(dirname "$0")"

deploy_log="$(mktemp)"
trap 'rm -f "$deploy_log"' EXIT

modal deploy app.py 2>&1 | tee "$deploy_log"

# Modal names each web_server function's URL after the function (underscores
# become hyphens) — `serve` -> ...-serve.modal.run, `serve_chat` ->
# ...-serve-chat.modal.run. If this doesn't match, check $deploy_log for the
# actual URLs modal printed.
base_url="$(grep -oE 'https://[^[:space:]]*-serve\.modal\.run' "$deploy_log" | head -1)"
chat_url="$(grep -oE 'https://[^[:space:]]*-serve-chat\.modal\.run' "$deploy_log" | head -1)"

warm_up() {
  local url="$1" model="$2" path="$3" body="$4"
  if [ -z "$url" ]; then
    echo "Couldn't find the deployed URL for '$model' in modal's output; skipping warm-up request." >&2
    return
  fi
  echo "Warming up $model at $url (this loads the model onto the GPU, can take a few minutes)..."
  curl -sS --max-time 600 "$url$path" \
    -H 'content-type: application/json' \
    -d "$body" \
    -o /dev/null -w 'warm-up request: HTTP %{http_code} in %{time_total}s\n'
}

warm_up "$base_url" "base" "/v1/completions" '{"model": "base", "prompt": "Hello", "max_tokens": 1}'
warm_up "$chat_url" "chat" "/v1/chat/completions" '{"model": "chat", "messages": [{"role": "user", "content": "Hello"}], "max_tokens": 1}'
